# Local development configuration
DATABASE_URL=sqlite:///./ice.db
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

SITE_URL=http://127.0.0.1:8000

# Payment method - set to 'manual' to display account details instead of using Paystack
# Set PAYSTACK_SECRET_KEY and PAYSTACK_PUBLIC_KEY if using Paystack integration
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...

# For manual bank transfer mode:
# Users will see account details on the give page and transfer manually
# After transfer, use /give/verify/{reference} to record the donation